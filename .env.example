# Express server port.
PORT=3000

# Optional live parking feed endpoint. Leave blank to use seeded/local data.
PARKKEAN_LIVE_API_URL=

# Optional credential for the live parking feed. Do not commit real secrets.
PARKKEAN_LIVE_API_KEY=

# Header used when PARKKEAN_LIVE_API_KEY is set.
PARKKEAN_LIVE_API_KEY_HEADER=Authorization

# Live feed request timeout in milliseconds.
PARKKEAN_LIVE_TIMEOUT_MS=5000
